BOT_TOKEN=
PUBLIC_BASE_URL=
WEBHOOK_SECRET=
# ERA Mini App (Telegram WebApp). The frontend is built into this same
# service (see Dockerfile) and served at PUBLIC_BASE_URL + /app/, so
# MINIAPP_URL only needs a value if the frontend is hosted elsewhere.
# MINIAPP_AUTH_SECRET must be set for the "Open ERA" button to work; until
# then the button stays hidden (bot behaves exactly as before).
MINIAPP_URL=
MINIAPP_AUTH_SECRET=
# Shared secret for metadata-only callbacks from the Database backup
# GitHub Actions workflow. Configure the same value in Render and GitHub.
BACKUP_REPORT_SECRET=
BOT_USERNAME=
DEV_AUTH_ENABLED=false
INIT_DATA_MAX_AGE_SECONDS=3600
DATABASE_URL=postgresql+asyncpg://era:era@db:5432/era
REDIS_URL=redis://redis:6379/0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
