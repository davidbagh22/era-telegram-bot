BOT_TOKEN=
PUBLIC_BASE_URL=
WEBHOOK_SECRET=
# ERA Mini App (Telegram WebApp). The frontend is built into this same
# service (see Dockerfile) and served at PUBLIC_BASE_URL + /app/.
MINIAPP_URL=
MINIAPP_AUTH_SECRET=
# Database backup authentication does not use a shared Render/GitHub secret.
# The exact main-branch GitHub Actions workflow authenticates with a
# short-lived GitHub OIDC token; its encrypted-backup key is domain-separated
# from MINIAPP_AUTH_SECRET inside the production process.
BOT_USERNAME=
DEV_AUTH_ENABLED=false
INIT_DATA_MAX_AGE_SECONDS=3600
DATABASE_URL=postgresql+asyncpg://era:era@db:5432/era
REDIS_URL=redis://redis:6379/0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
